    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "gh-pages": "^6.3.0",
    "prettier": "^3.9.10",
    "ts-prune": "^0.10.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-comlink": "^5.3.0",
    "vite-plugin-wasm": "^3.6.0",
    "wasm-loader": "^1.3.0",
    "worker-plugin": "^5.0.1",
    "workerize-loader": "^2.0.2"
  },
  "dependencies": {
    "bulma": "^1.0.4",
    "comlink": "^4.4.2",
    "crate-connect-four": "./connect-four/pkg",
    "crate-mancala": "./mancala/pkg",
    "crate-tic-tac-toe": "./tic-tac-toe/pkg",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "web-vitals": "^6.2.3"
  },
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:wasm:dev": "bash scripts/build-wasm.sh --dev",
    "dev": "pnpm run build:wasm:dev && vite",
    "build": "pnpm run build:wasm && tsc && vite build",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "test": "pnpm test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "playwright:install": "playwright install",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
